{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "groomnote-public-showcase",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "vars": {
    "APP_ENV": "test",
    "HACKATHON_MODE": "false", // Legacy quota regression only.
    "ANALYZER_MODE": "fake",
    "TTS_MODE": "fake",
    "STT_TOKEN_MODE": "fake",
    "DEMO_API_KEY": "PUBLIC_CONFIGURATION_PLACEHOLDER",
    "CORS_ALLOWED_ORIGIN": "http://127.0.0.1:5173",
    "TURNSTILE_SECRET_KEY": "PUBLIC_CONFIGURATION_PLACEHOLDER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "groomnote-public-showcase",
      "database_id": "PUBLIC_CONFIGURATION_PLACEHOLDER",
      "migrations_dir": "migrations"
    }
  ]
}
