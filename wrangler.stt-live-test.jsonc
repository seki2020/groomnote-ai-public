{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "groomnote-public-showcase",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "vars": {
    "APP_ENV": "development",
    "ANALYZER_MODE": "fake",
    "TTS_MODE": "fake",
    "STT_TOKEN_MODE": "assemblyai"
  },
  "secrets": {
    "required": ["ASSEMBLYAI_API_KEY", "DEMO_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "groomnote-public-showcase",
      "database_id": "PUBLIC_CONFIGURATION_PLACEHOLDER",
      "migrations_dir": "migrations"
    }
  ]
}
