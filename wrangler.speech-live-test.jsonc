{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "groomnote-public-showcase",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "vars": {
    "APP_ENV": "development",
    "ANALYZER_MODE": "fake",
    "TTS_MODE": "workers-ai",
    "DEMO_API_KEY": "PUBLIC_CONFIGURATION_PLACEHOLDER"
  },
  "ai": { "binding": "AI", "remote": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "groomnote-public-showcase",
      "database_id": "PUBLIC_CONFIGURATION_PLACEHOLDER",
      "migrations_dir": "migrations"
    }
  ]
}
